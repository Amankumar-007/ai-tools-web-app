# Copy to .env.local and fill in. Never commit real values.
# Anything starting with NEXT_PUBLIC_ is shipped to every visitor's browser: keep secrets out of those.

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Extra hostnames allowed to call POST APIs from a browser (comma separated). Usually empty.
ALLOWED_ORIGINS=

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Strongly recommended: lets the server verify sign-in tokens locally (faster, no network call).
# Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# Server only. Needed for admin writes once you apply supabase-hardening.sql. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (server only) ──────────────────────────────────────────
# Daily Tools (AI) try GEMINI_API_KEY first, then OPENROUTER_API_KEY. Free tiers are small (see DAILY_TOOLS.md): use a billing-enabled key before promoting the tools.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Image generation in the chat ("Generate an image of ...") uses OpenRouter's Images API with OPENROUTER_API_KEY.
# Default model: recraft/recraft-v4.1-flash-v2:free. That free variant is retired on 2026-11-28: from then on set the paid id below (paid endpoints stay available).
# OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2
# Chat falls back to Gemini (GEMINI_API_KEY) when OpenRouter's free models are out of allowance. A key WITHOUT credits gets only 50 free-model requests a day
# for the whole site (1000 after adding 10 credits at openrouter.ai/settings/credits); the chat then shows when it comes back (midnight UTC = 5:30 am IST).
# Chat routing: a free decision model (Perplexity Decider) reads each message to pick the best chat model; keyword rules are the fallback.
# It only runs when the key has credits (each decision is one more request on the 50/day allowance). OPENROUTER_DECIDER=on forces it, off disables it.
# Optional override (comma separated, tried in order): OPENROUTER_DECIDER_MODELS=perplexity/pplx-decider-v1.3:free,perplexity/pplx-decider-flash-v1.3:free

# ── Admin area (run `node scripts/admin-setup.cjs` to generate the last two) ──
ADMIN_EMAIL=
ADMIN_JWT_SECRET=
ADMIN_PASSWORD_HASH=
# Optional: Supabase accounts that may also sign in as admin (comma separated)
ADMIN_EMAILS=

# ── Rate limiting ───────────────────────────────────────────────────────
# Recommended in production: a free Upstash Redis database makes limits hold across all serverless
# instances. Without it, limits are per instance (fine for development, weaker in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Multiply every limit (0.5 = half as generous, 2 = twice as generous). Default 1.
RL_SCALE=1
# Site-wide ceiling on AI requests per day: a hard stop on runaway spend. Default 20000.
AI_GLOBAL_DAILY_CAP=20000

# ── Hosting ─────────────────────────────────────────────────────────────
# Set to 1 ONLY if the app runs behind a reverse proxy you control that overwrites X-Forwarded-For / X-Real-IP
# (nginx, Cloudflare, a load balancer). Not needed on Vercel. When unset off-Vercel, every caller shares one
# rate-limit bucket, because forwarding headers cannot be believed.
TRUST_PROXY_HEADERS=

# ── Billing (Razorpay) and plans ────────────────────────────────────────
# Paid plans switch on only when ALL of these are set (otherwise the pricing page shows a waitlist):
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SUPABASE_URL.
# Use rzp_test_ keys first. Prices live in src/lib/billing/plans.ts and are sent with each order: nothing to create in the dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook in Razorpay (Account & Settings -> Webhooks). NOT the API key secret.
RAZORPAY_WEBHOOK_SECRET=
# inr (default) or usd. USD only works if international payments are enabled on your Razorpay account.
BILLING_CURRENCY=inr
# Optional per-plan daily limit overrides, e.g. PLAN_FREE_CHAT_PER_DAY=30 (see GROWTH.md)
PLAN_FREE_CHAT_PER_DAY=
PLAN_FREE_TOOL_PER_DAY=
PLAN_PRO_CHAT_PER_DAY=
PLAN_PRO_TOOL_PER_DAY=
PLAN_PREMIUM_CHAT_PER_DAY=
PLAN_PREMIUM_TOOL_PER_DAY=
# Set to 1 to switch off credits, streaks, referrals and the newsletter
GROWTH_DISABLED=

# ── Cron ────────────────────────────────────────────────────────────────
# Required, or /api/cron/* refuses every call. Vercel sends it automatically as a Bearer token.
CRON_SECRET=
